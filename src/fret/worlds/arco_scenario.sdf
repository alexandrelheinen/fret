<?xml version="1.0"?>
<!--
  ARCO Scenario: Gazebo Obstacle World (Issue 02)

  A deterministic planning-and-tracking validation environment for a
  floor-mounted UR3 manipulator.  All models are static so the world can
  be replayed with an identical initial state.

  Coordinate frame: REP-105 / world origin at the robot base-link.
  All positions are expressed in metres; all orientations in roll-pitch-yaw
  (radians) following the SDF convention (x forward, y left, z up).

  Obstacle layout (XY plane, robot base at origin):
  ┌──────────────────────────────────────────────────────────────────────┐
  │  obstacle_pillar_left   (0.30,  0.22, 0.25) – left gate pillar       │
  │  obstacle_pillar_right  (0.30, -0.22, 0.25) – right gate pillar      │
  │  obstacle_crossbar      (0.30,  0.00, 0.52) – top bar of gate        │
  │  obstacle_block_a       (0.45,  0.10, 0.05) – post-gate block left   │
  │  obstacle_block_b       (0.45, -0.10, 0.05) – post-gate block right  │
  │  region_start  (green)  (0.15,  0.30, 0.005)                         │
  │  region_target (red)    (0.42, -0.18, 0.005)                         │
  └──────────────────────────────────────────────────────────────────────┘

  Startup success criteria:
  - All seven named models are present in the Gazebo entity list.
  - The /world/arco_scenario/model_info topic returns stable poses.
  - robot_state_publisher emits a valid /tf tree within 5 s of launch.
-->
<sdf version="1.9">
  <world name="arco_scenario">

    <!-- ── Plugins ────────────────────────────────────────────────── -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <!-- ── Physics ───────────────────────────────────────────────── -->
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ── Lighting ──────────────────────────────────────────────── -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ── Ground plane ──────────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Obstacle 1: left gate pillar ──────────────────────────── -->
    <!--
      Vertical box column on the left side of the narrow passage.
      Together with obstacle_pillar_right and obstacle_crossbar it forms
      a gate structure that forces the planner to thread the arm through
      a constrained opening.
    -->
    <model name="obstacle_pillar_left">
      <static>true</static>
      <pose>0.30 0.22 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.50</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.50</size>
            </box>
          </geometry>
          <material>
            <ambient>0.20 0.20 0.80 1</ambient>
            <diffuse>0.20 0.20 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Obstacle 2: right gate pillar ─────────────────────────── -->
    <model name="obstacle_pillar_right">
      <static>true</static>
      <pose>0.30 -0.22 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.50</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.50</size>
            </box>
          </geometry>
          <material>
            <ambient>0.20 0.20 0.80 1</ambient>
            <diffuse>0.20 0.20 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Obstacle 3: gate crossbar (occlusion) ─────────────────── -->
    <!--
      Horizontal bar bridging the two pillars at their top, creating an
      L-shaped occlusion for depth cameras mounted above the workspace.
    -->
    <model name="obstacle_crossbar">
      <static>true</static>
      <pose>0.30 0.00 0.52 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.50 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.50 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.20 0.20 0.80 1</ambient>
            <diffuse>0.20 0.20 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Obstacle 4: post-gate block A ─────────────────────────── -->
    <!--
      Small cube beyond the gate on the left side.  It must be avoided
      while the end-effector approaches the target region, introducing
      a local-minimum risk for sampling-based planners.
    -->
    <model name="obstacle_block_a">
      <static>true</static>
      <pose>0.45 0.10 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 0.10 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 0.10 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.80 0.50 0.10 1</ambient>
            <diffuse>0.80 0.50 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Obstacle 5: post-gate block B ─────────────────────────── -->
    <model name="obstacle_block_b">
      <static>true</static>
      <pose>0.45 -0.10 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 0.10 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 0.10 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.80 0.50 0.10 1</ambient>
            <diffuse>0.80 0.50 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Start region marker (visual only, green) ───────────────── -->
    <!--
      Flat disc on the floor indicating the canonical start configuration
      projection.  No collision geometry; planning and tracking code must
      reference the joint-space start pose defined in spec-issue-02.
    -->
    <model name="region_start">
      <static>true</static>
      <pose>0.15 0.30 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 0.08 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.80 0.10 0.8</ambient>
            <diffuse>0.10 0.80 0.10 0.8</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Target region marker (visual only, red) ────────────────── -->
    <!--
      Flat disc indicating the canonical goal configuration projection.
      No collision geometry.
    -->
    <model name="region_target">
      <static>true</static>
      <pose>0.42 -0.18 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 0.08 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.80 0.10 0.10 0.8</ambient>
            <diffuse>0.80 0.10 0.10 0.8</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
