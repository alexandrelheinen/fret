<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="arco_scenario">

    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle: 6×6×30 cm column at (0.44, 0.30, 0.15) — farthest from origin -->
    <model name="obstacle_box_a">
      <static>true</static>
      <pose>0.44 0.30 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.06 0.06 0.30</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.06 0.06 0.30</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.4 0.0 1</ambient>
            <diffuse>0.8 0.4 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Start region: green visual-only sphere at (0.0, 0.0, 0.05) r=0.03 m -->
    <model name="region_start">
      <static>true</static>
      <pose>0.0 0.0 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.03</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.0 0.8 0.0 0.6</ambient>
            <diffuse>0.0 0.8 0.0 0.6</diffuse>
          </material>
          <transparency>0.4</transparency>
        </visual>
      </link>
    </model>

    <!-- Target region: red visual-only sphere at (0.30, 0.10, 0.05) r=0.03 m -->
    <model name="region_target">
      <static>true</static>
      <pose>0.30 0.10 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.03</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.8 0.0 0.0 0.6</ambient>
            <diffuse>0.8 0.0 0.0 0.6</diffuse>
          </material>
          <transparency>0.4</transparency>
        </visual>
      </link>
    </model>

  </world>
</sdf>
