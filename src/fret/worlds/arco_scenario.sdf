<?xml version="1.0"?>
<!--
  ARCO Scenario: Gazebo Obstacle World (Issue 02)

  A deterministic planning-and-tracking validation environment for the
  floor-mounted SCARA manipulator (R-R-P-R, reach 600 mm).  All models
  are static so the world can be replayed with an identical initial state.

  Coordinate frame: REP-105 / world origin at the robot base-link.
  All positions are expressed in metres; all orientations in roll-pitch-yaw
  (radians) following the SDF convention (x forward, y left, z up).

  Obstacle layout (XY plane, robot base at origin):
  ┌──────────────────────────────────────────────────────────────────────┐
  │  obstacle_box_a  (0.25,  0.00, 0.05) – centre block                  │
  │  obstacle_box_b  (0.35,  0.12, 0.05) – left block                    │
  │  obstacle_box_c  (0.35, -0.12, 0.05) – right block                   │
  │  region_start  (green)  (0.20,  0.30, 0.005)                         │
  │  region_target (red)    (0.45, -0.20, 0.005)                         │
  └──────────────────────────────────────────────────────────────────────┘

  All obstacles are 0.10 × 0.10 × 0.10 m cubes resting on the floor.
  The SCARA arm body clears them (arm link z ≥ 0.17 m); only the quill
  extension (z down to 0.04 m at full travel) can collide.

  Startup success criteria:
  - All five named models are present in the Gazebo entity list.
  - The /world/arco_scenario/model_info topic returns stable poses.
  - robot_state_publisher emits a valid /tf tree within 5 s of launch.
-->
<sdf version="1.9">
  <world name="arco_scenario">

    <!-- ── Plugins ────────────────────────────────────────────────── -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <!-- ── Physics ───────────────────────────────────────────────── -->
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ── Lighting ──────────────────────────────────────────────── -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ── Ground plane ──────────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Obstacle 1: centre block ──────────────────────────────── -->
    <!--
      10 cm cube in the forward workspace centre.  Forces the planner to
      swing left or right before reaching the target region.
    -->
    <model name="obstacle_box_a">
      <static>true</static>
      <pose>0.25 0.00 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 0.10 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 0.10 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.20 0.20 0.80 1</ambient>
            <diffuse>0.20 0.20 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Obstacle 2: left block ─────────────────────────────────── -->
    <!--
      10 cm cube on the left side of the workspace.  Creates a channel
      that the planner must exploit to reach the target.
    -->
    <model name="obstacle_box_b">
      <static>true</static>
      <pose>0.35 0.12 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 0.10 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 0.10 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.80 0.50 0.10 1</ambient>
            <diffuse>0.80 0.50 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Obstacle 3: right block ────────────────────────────────── -->
    <model name="obstacle_box_c">
      <static>true</static>
      <pose>0.35 -0.12 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 0.10 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 0.10 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.80 0.50 0.10 1</ambient>
            <diffuse>0.80 0.50 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Start region marker (visual only, green) ───────────────── -->
    <!--
      Flat tile on the floor indicating the canonical start configuration
      projection.  No collision geometry; planning and tracking code must
      reference the joint-space start pose defined in spec-issue-02.
    -->
    <model name="region_start">
      <static>true</static>
      <pose>0.20 0.30 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 0.08 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.80 0.10 0.8</ambient>
            <diffuse>0.10 0.80 0.10 0.8</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Target region marker (visual only, red) ────────────────── -->
    <!--
      Flat tile indicating the canonical goal configuration projection.
      No collision geometry.
    -->
    <model name="region_target">
      <static>true</static>
      <pose>0.45 -0.20 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 0.08 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.80 0.10 0.10 0.8</ambient>
            <diffuse>0.80 0.10 0.10 0.8</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

