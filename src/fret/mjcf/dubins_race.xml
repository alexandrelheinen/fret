<mujoco model="dubins_race">
  <!--
    Dubins dual-robot warehouse race (SC-v11 / T11-02).

    Floor: 10 m × 10 m AWS RoboMaker ground texture (lab-scale).
    Obstacles: analytic boxes from config/worlds/dubins_race_obstacles.yml
                with AWS clutter mesh visuals (regenerate via
                scripts/generate_dubins_race_mjcf.py).
    Agents: real-scale TurtleBot3 Burger (RRT* blue, SST green, dummy grey)
            with 2× Menagerie wheel actuators (±13.34 rad/s ≈ 0.44 m/s).
    All three are stepped in the same physics tick (true concurrent race).
    Agent–agent contacts are disabled; shells still hit warehouse structures.
    Dummy Pure-Pursuits the straight start→goal line (showcase foil).
  -->
  <!-- meshdir="." so TB3 can resolve the Menagerie submodule and AWS OBJs. -->
  <compiler angle="radian" coordinate="local"
            meshdir="."
            texturedir="assets/aws_warehouse/textures"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <geom friction="1 0.2 0.005" solref="0.01 1" solimp="0.9 0.95 0.001"/>
    <default class="tb3_visual">
      <geom type="mesh" contype="0" conaffinity="0" density="0" group="2"/>
    </default>
    <default class="tb3_collision">
      <!-- Wheel meshes contact the floor (bit 1). Chassis meshes override to 0. -->
      <geom group="3" type="mesh" contype="1" conaffinity="1"
            friction="1.5 0.05 0.001"/>
    </default>
    <default class="tb3_chassis_collision">
      <geom group="3" type="mesh" contype="0" conaffinity="0" density="0"/>
    </default>
    <default class="agent_shell">
      <!-- Structures only (bit 2). conaffinity=0 → no agent–agent shell hits. -->
      <geom type="box" contype="2" conaffinity="0" rgba="0 0 0 0"/>
    </default>
    <default class="structure_col">
      <geom type="box" contype="2" conaffinity="2" rgba="0 0 0 0"/>
    </default>
  </default>

  <visual>
    <headlight ambient="0.50 0.52 0.55" diffuse="0.28 0.30 0.33" specular="0 0 0"/>
    <rgba haze="0.72 0.74 0.78 0.25"/>
    <global azimuth="140" elevation="-28" offwidth="1920" offheight="1080"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.78 0.80 0.84" rgb2="0.58 0.61 0.66" width="512" height="1536"/>
    <texture name="ground_tex" type="2d" file="ground.png"/>

    <material name="floor" texture="ground_tex" texuniform="true" texrepeat="4 4" reflectance="0.01"/>
    <material name="start_zone" rgba="0.20 0.75 0.35 0.35"/>
    <material name="goal_zone" rgba="0.85 0.25 0.20 0.35"/>
    <material name="car_rrt" rgba="0.267 0.467 0.800 1" specular="0.15" shininess="0.08"/>
    <material name="car_sst" rgba="0.267 0.667 0.400 1" specular="0.15" shininess="0.08"/>
    <material name="car_dummy" rgba="0.55 0.56 0.58 1" specular="0.10" shininess="0.06"/>
    <material name="wheel" rgba="0.10 0.10 0.11 1" specular="0.05" shininess="0.04"/>
    <material name="tb3_hardware" rgba="0.62 0.63 0.66 1" specular="0.20" shininess="0.12"/>
    <material name="shelf" rgba="0.72 0.74 0.78 1" specular="0.06" shininess="0.04"/>
    <material name="clutter_cardboard" rgba="0.62 0.48 0.32 1" specular="0.04" shininess="0.03"/>
    <material name="clutter_crate" rgba="0.55 0.38 0.22 1" specular="0.05" shininess="0.04"/>
    <material name="clutter_pallet" rgba="0.48 0.42 0.36 1" specular="0.04" shininess="0.03"/>

    <!-- Backdrop shelf (lab-scale). Structure instances use auto-generated meshes. -->
    <mesh name="shelf" file="assets/aws_warehouse/meshes/shelf.obj" scale="0.45 0.45 0.45"/>

    <!-- TurtleBot3 Burger from submodule third_party/robotis_mujoco_menagerie (Apache-2.0). -->
    <mesh name="burger_base" file="../../../third_party/robotis_mujoco_menagerie/robotis_tb3/assets/burger_base.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_tire" file="../../../third_party/robotis_mujoco_menagerie/robotis_tb3/assets/left_tire.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_tire" file="../../../third_party/robotis_mujoco_menagerie/robotis_tb3/assets/right_tire.stl" scale="0.001 0.001 0.001"/>
    <mesh name="lds" file="../../../third_party/robotis_mujoco_menagerie/robotis_tb3/assets/lds.stl" scale="0.001 0.001 0.001"/>

    <!-- Warehouse structure meshes (auto-generated) -->
