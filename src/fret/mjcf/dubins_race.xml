    <geom name="str_000_col" class="structure_col" pos="2.51 3.49 0.57" size="0.55 0.22 0.57"/>
    <geom name="str_000_vis" type="mesh" mesh="clutter_a" pos="1.960 3.270 0" size="0.4049 0.1753 0.8588" material="clutter_cardboard" contype="0" conaffinity="0"/>
