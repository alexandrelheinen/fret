    <!-- End warehouse structure block -->


    <!-- Agent rrt: true TB3 differential-drive -->
    <body name="car_rrt" pos="0 0 0">
      <inertial pos="-0.032 0 0.03" mass="0.9" diaginertia="0.005 0.005 0.003"/>
      <freejoint name="rrt_base_joint"/>
      <!-- Raised so the box does not skid on the floor (wheels provide contact). -->
      <geom name="rrt_collision" class="agent_shell" pos="-0.032 0 0.12" size="0.14 0.12 0.06"/>
      <geom pos="-0.032 0 0.01" mesh="burger_base" material="car_rrt" class="tb3_visual"/>
      <geom pos="-0.032 0 0.01" mesh="burger_base" class="tb3_chassis_collision"/>
      <geom size="0.005" pos="-0.081 0 0.005" type="sphere" material="wheel"
            friction="0.0001 0.0001 0.0001" solref="0.02 1"
            solimp="0.95 0.99 0.001" condim="1"/>
      <geom pos="-0.032 0 0.182" mesh="lds" material="car_rrt" class="tb3_visual"/>
      <body name="rrt_wheel_left" pos="0 0.08 0.033" quat="0.707388 -0.706825 0 0">
        <inertial pos="0 0 0" quat="-0.000890159 0.706886 0.000889646 0.707326"
                  mass="0.0284989"
                  diaginertia="2.07126e-05 1.11924e-05 1.11756e-05"/>
        <joint name="rrt_wheel_left" type="hinge" axis="0 0 1"
               limited="false" frictionloss="0.1" armature="0.01"/>
        <geom quat="0.707388 0.706825 0 0" mesh="left_tire" material="wheel" class="tb3_visual"/>
        <geom quat="0.707388 0.706825 0 0" mesh="left_tire" class="tb3_collision"/>
      </body>
