    <velocity name="rrt_wheel_left" joint="rrt_wheel_left" kv="0.2"
              ctrlrange="-13.34 13.34" ctrllimited="true"/>
    <velocity name="rrt_wheel_right" joint="rrt_wheel_right" kv="0.2"
              ctrlrange="-13.34 13.34" ctrllimited="true"/>
