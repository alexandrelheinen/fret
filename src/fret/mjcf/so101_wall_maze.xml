<mujoco model="so101_wall_maze">
  <!--
    SO-101 dual Γ pick-and-place cell (SC-v20d).

    Same ball, bin, and friction grasp as SC-v20b. Two Γ obstacles flank
    the bin: stems rise beside the mouth and caps overhang toward the pick
    and past the far wall, so the straight lift-to-place swing is blocked.
    The release segment above the rim stays open. Wall AABBs match
    so101_wall_maze.yml.
  -->
  <include file="so101.xml"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"
          cone="elliptic" impratio="10"/>

  <statistic center="0.15 0 0.15" extent="0.55"/>

  <visual>
    <headlight ambient="0.45 0.47 0.50" diffuse="0.30 0.32 0.35" specular="0 0 0"/>
    <rgba haze="0.75 0.78 0.82 0.2"/>
    <global azimuth="140" elevation="-25" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient"
             rgb1="0.78 0.80 0.84" rgb2="0.55 0.58 0.62"
             width="512" height="1536"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.85 0.86 0.88" rgb2="0.72 0.74 0.76"
             markrgb="0.55 0.56 0.58" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="4 4" reflectance="0.05"/>
    <material name="place_bin" rgba="0.55 0.58 0.62 1"/>
    <material name="pick_ball" rgba="0.85 0.92 0.20 1" reflectance="0.05"/>
    <material name="table" rgba="0.55 0.42 0.30 1" reflectance="0.08"/>
    <material name="transfer_wall" rgba="0.55 0.38 0.28 1" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light name="key" pos="0.3 0.2 0.8" dir="0 0 -1" directional="true"
           diffuse="0.45 0.46 0.48" specular="0.05 0.05 0.05"/>
    <!-- Contact bits: arm=1, catcher=2, pads/distal=4, floor=1|8.
         Ball=2|4|8; place_bin contype=5 (bits 1|4) hit full arm. -->
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"
          friction="1.0 0.1 0.01" contype="9" conaffinity="9"/>

    <geom name="table_top" type="box" pos="0.1 0 -0.02" size="0.30 0.30 0.01"
          material="table" contype="0" conaffinity="0"/>

    <!-- Dual Γ beside the bin, clear of the pick. contype=5 hits the
         arm (bit 1) and the pads (bit 4). AABBs match so101_wall_maze.yml.
         Pick-side stem y=0..0.018 z=0..0.16; cap y=-0.03..0 z=0.19..0.24.
         Far stem y=0.150..0.172 z=0..0.15; cap y=0.172..0.23 z=0.155..0.215. -->
    <geom name="transfer_wall_stem" type="box"
          pos="0.21000 0.00900 0.08000" size="0.04000 0.00900 0.08000"
          material="transfer_wall" friction="1.0 0.1 0.01"
          contype="5" conaffinity="5"/>
    <geom name="transfer_wall_cap" type="box"
          pos="0.20500 -0.01500 0.21500" size="0.04500 0.01500 0.02500"
          material="transfer_wall" friction="1.0 0.1 0.01"
          contype="5" conaffinity="5"/>
    <geom name="transfer_wall_stem_p" type="box"
          pos="0.21000 0.16100 0.07500" size="0.04000 0.01100 0.07500"
          material="transfer_wall" friction="1.0 0.1 0.01"
          contype="5" conaffinity="5"/>
    <geom name="transfer_wall_cap_p" type="box"
          pos="0.20500 0.20100 0.18500" size="0.04500 0.02900 0.03000"
          material="transfer_wall" friction="1.0 0.1 0.01"
          contype="5" conaffinity="5"/>

    <!-- Place bin on +Y of the pick. Pad-mid place poses are offset so the
         contact-gated weld (ball↔gripper body) drops into this mouth. -->
    <geom name="place_bin_bottom" type="box" pos="0.20000 0.08000 0.00063"
          size="0.05500 0.05500 0.00063" material="place_bin"
          contype="5" conaffinity="5"/>
    <geom name="place_bin_wall_px" type="box" pos="0.25750 0.08000 0.04900"
          size="0.00250 0.06000 0.04900" material="place_bin"
          contype="5" conaffinity="5"/>
    <geom name="place_bin_wall_nx" type="box" pos="0.14250 0.08000 0.04900"
          size="0.00250 0.06000 0.04900" material="place_bin"
          contype="5" conaffinity="5"/>
    <geom name="place_bin_wall_py" type="box" pos="0.20000 0.13750 0.04900"
          size="0.05500 0.00250 0.04900" material="place_bin"
          contype="5" conaffinity="5"/>
    <geom name="place_bin_wall_ny" type="box" pos="0.20000 0.02250 0.04900"
          size="0.05500 0.00250 0.04900" material="place_bin"
          contype="5" conaffinity="5"/>

    <body name="pick_box" pos="0.20000 -0.12000 0.02000">
      <freejoint name="pick_box_joint"/>
      <geom name="pick_box_geom" type="sphere" size="0.020"
            density="400" material="pick_ball"
            friction="2.8 1.2 0.15" solref="0.012 1" solimp="0.9 0.95 0.001"
            condim="6" contype="14" conaffinity="14" priority="1"/>
    </body>

    <body name="cv_ball_ghost" pos="0 0 -1">
      <geom name="cv_ball_ghost" type="sphere" size="0.0280"
            contype="0" conaffinity="0" group="1"
            rgba="0.90 0.10 0.10 0.0"/>
    </body>

    <!-- Fixed overhead camera (1280x720, fovy 42 placeholder — PR5 calibrates). -->
    <camera name="overhead_cam" pos="0.15 0 0.85"
            xyaxes="0 1 0 -1 0 0" fovy="42"/>
    <camera name="overview" pos="0.55 -0.45 0.55"
            xyaxes="0.75 0.66 0 -0.35 0.40 0.85" fovy="40"/>
  </worldbody>

  <!-- Contact-gated grasp hold (see docs/decisions.md): inactive by default;
       the runner enables it only while both pads contact and the jaw is
       closed. Not a MuJoCo adhesion actuator. -->
  <equality>
    <weld name="friction_grasp_weld" body1="pick_box" body2="gripper"
          active="false" solref="0.01 1" solimp="0.95 0.99 0.001"/>
  </equality>
</mujoco>

