<mujoco model="ppp_unit">
  <!--
    Minimal Cartesian (PPP) physics sandbox (FR-SIM-11 / SC-v12u).

    Three prismatic slides with light masses and gravity compensation so
    open-loop velocity commands move X/Y/Z and hold altitude. No warehouse,
    cargo, or mesh assets — unit-test foundation only.
  -->
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <worldbody>
    <light pos="2 2 4" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="5 5 0.05" rgba="0.85 0.85 0.88 1"/>

    <body name="x_carriage" gravcomp="1">
      <inertial pos="0 0 0" mass="1.0" diaginertia="0.01 0.01 0.01"/>
      <joint name="joint_x" type="slide" axis="1 0 0" range="0 4" damping="1"/>
      <geom type="box" size="0.08 0.08 0.08" mass="1.0" rgba="0.82 0.48 0.12 1"
            contype="0" conaffinity="0"/>

      <body name="y_carriage" gravcomp="1">
        <inertial pos="0 0 0" mass="0.8" diaginertia="0.008 0.008 0.008"/>
        <joint name="joint_y" type="slide" axis="0 1 0" range="0 4" damping="1"/>
        <geom type="box" size="0.07 0.07 0.07" mass="0.8" rgba="0.88 0.68 0.15 1"
              contype="0" conaffinity="0"/>

        <body name="z_hoist" gravcomp="1">
          <inertial pos="0 0 0" mass="0.6" diaginertia="0.006 0.006 0.006"/>
          <joint name="joint_z" type="slide" axis="0 0 1" range="0 3" damping="1"/>
          <geom type="box" size="0.06 0.06 0.10" mass="0.6" rgba="0.40 0.62 0.48 1"
                contype="0" conaffinity="0"/>
        </body>
      </body>
    </body>

    <camera name="overview" pos="3 3 3" xyaxes="-0.7 0.7 0 -0.4 -0.4 0.8"/>
  </worldbody>

  <actuator>
    <velocity name="act_joint_x" joint="joint_x" kv="200"
              forcelimited="true" forcerange="-500 500" ctrlrange="-3 3"/>
    <velocity name="act_joint_y" joint="joint_y" kv="200"
              forcelimited="true" forcerange="-500 500" ctrlrange="-3 3"/>
    <velocity name="act_joint_z" joint="joint_z" kv="300"
              forcelimited="true" forcerange="-500 500" ctrlrange="-3 3"/>
  </actuator>
</mujoco>
