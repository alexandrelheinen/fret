<mujoco model="omx_tabletop">
  <!--
    OpenMANIPULATOR-X empty tabletop cell (SC-v13a / T13-01).

    Template only: fret.mjcf.omx.ensure_omx_tabletop_mjcf() merges this with
    Menagerie open_manipulator_x.xml (absolute meshdir) into
    src/fret/mjcf/.generated/omx_tabletop.xml.

    No obstacles — validates the command chain A→B. AWS desk clutter = SC-v13b.
  -->
  <include file="open_manipulator_x.xml"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <statistic center="0.05 0 0.20" extent="0.7"/>

  <visual>
    <headlight ambient="0.45 0.47 0.50" diffuse="0.30 0.32 0.35" specular="0 0 0"/>
    <rgba haze="0.75 0.78 0.82 0.2"/>
    <global azimuth="140" elevation="-25" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient"
             rgb1="0.78 0.80 0.84" rgb2="0.55 0.58 0.62"
             width="512" height="1536"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.85 0.86 0.88" rgb2="0.72 0.74 0.76"
             markrgb="0.55 0.56 0.58" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="4 4" reflectance="0.05"/>
    <material name="table" rgba="0.55 0.42 0.30 1" reflectance="0.08"/>
    <!-- Same convention as Dubins race: green = start, red = goal. -->
    <material name="start_zone" rgba="0.20 0.75 0.35 0.35"/>
    <material name="goal_zone" rgba="0.85 0.25 0.20 0.35"/>
  </asset>

  <worldbody>
    <light name="key" pos="0.6 0.4 1.2" dir="0 0 -1" directional="true"
           diffuse="0.45 0.46 0.48" specular="0.05 0.05 0.05"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"
          friction="1 0.1 0.01"/>

    <!-- Visual lab table sized for ~0.5 m EE XY arcs (non-colliding). -->
    <geom name="table_top" type="box" pos="0.05 0 -0.02" size="0.40 0.40 0.01"
          material="table" contype="0" conaffinity="0"/>

    <!-- Floor marks under EE XY for SC-v13a ±80° yaw reach path. -->
    <geom name="start_zone" type="cylinder" pos="0.0554 -0.2462 0.002" size="0.04 0.001"
          material="start_zone" contype="0" conaffinity="0"/>
    <geom name="goal_zone" type="cylinder" pos="0.0554 0.2462 0.002" size="0.04 0.001"
          material="goal_zone" contype="0" conaffinity="0"/>

    <!-- Top-down free-space proof (SC-v13a showcase). -->
    <camera name="topdown" pos="0.05 0 1.15"
            xyaxes="0 1 0 -1 0 0" fovy="55"/>
    <!-- Isometric overview: arm + green start / red goal pads. -->
    <camera name="overview" pos="0.72 -0.78 0.78"
            xyaxes="0.82 0.57 0 -0.32 0.46 0.83" fovy="40"/>
    <camera name="follow" pos="0.45 0.35 0.35"
            xyaxes="-0.7 0.7 0 -0.3 -0.3 0.9" fovy="50"/>
  </worldbody>
</mujoco>


