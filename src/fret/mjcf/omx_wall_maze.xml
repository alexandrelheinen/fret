    <geom name="funnel_w22" type="box" size="0.0025 0.00757 0.05501" pos="0.27923 0.13270 0.04900" quat="-0.760180 -0.145714 -0.182720 0.606224" rgba="0.55 0.42 0.35 0" friction="1.4 0.1 0.01" contype="2" conaffinity="2"/>
