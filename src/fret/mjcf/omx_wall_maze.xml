    <!-- Isometric overview: arm + Γ-wall maze + pick/place. -->
    <camera name="overview" pos="0.85 -0.55 0.75"
            xyaxes="0.55 0.84 0 -0.40 0.26 0.88" fovy="40"/>
    <camera name="follow" pos="0.55 0.40 0.35"
