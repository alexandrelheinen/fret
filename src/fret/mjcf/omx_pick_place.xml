<mujoco model="omx_pick_place">
  <!--
    OpenMANIPULATOR-X pick-and-place cell (SC-v13b / T13-04).

    Stretched pedestals (~2.3× farther than the early close-in layout) so the
    arm must reach out. Plain free box; green = pick, red = place.
    Grasp is full MuJoCo physics (finger pads + adhesion actuators injected by
    omx.py). Pedestals collide with the box only so the wrist can clear them.
  -->
  <include file="open_manipulator_x.xml"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"
          cone="elliptic" impratio="10"/>

  <statistic center="0.20 0 0.18" extent="0.65"/>

  <visual>
    <headlight ambient="0.45 0.47 0.50" diffuse="0.30 0.32 0.35" specular="0 0 0"/>
    <rgba haze="0.75 0.78 0.82 0.2"/>
    <global azimuth="140" elevation="-25" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient"
             rgb1="0.78 0.80 0.84" rgb2="0.55 0.58 0.62"
             width="512" height="1536"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.85 0.86 0.88" rgb2="0.72 0.74 0.76"
             markrgb="0.55 0.56 0.58" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="4 4" reflectance="0.05"/>
    <material name="pedestal" rgba="0.45 0.46 0.48 1"/>
    <material name="start_zone" rgba="0.20 0.75 0.35 0.35"/>
    <material name="goal_zone" rgba="0.85 0.25 0.20 0.35"/>
    <material name="pick_box" rgba="0.90 0.75 0.20 1" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light name="key" pos="0.8 0.5 1.4" dir="0 0 -1" directional="true"
           diffuse="0.45 0.46 0.48" specular="0.05 0.05 0.05"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"
          friction="1.0 0.1 0.01" contype="1" conaffinity="1"/>

    <!-- Thin posts at fingertip reach (~0.32 m). contype=2: box only. -->
    <geom name="pedestal_pick" type="cylinder" pos="0.273 -0.160 0.079" size="0.018 0.079"
          material="pedestal" friction="1.2 0.1 0.01" contype="2" conaffinity="2"/>
    <geom name="pedestal_place" type="cylinder" pos="0.273 0.160 0.079" size="0.018 0.079"
          material="pedestal" friction="1.2 0.1 0.01" contype="2" conaffinity="2"/>

    <geom name="start_zone" type="cylinder" pos="0.273 -0.160 0.159" size="0.05 0.001"
          material="start_zone" contype="0" conaffinity="0"/>
    <geom name="goal_zone" type="cylinder" pos="0.273 0.160 0.159" size="0.05 0.001"
          material="goal_zone" contype="0" conaffinity="0"/>

    <!-- ~20 mm cube; contype=3 hits floor (1) and pedestals (2). -->
    <body name="pick_box" pos="0.273 -0.160 0.168">
      <freejoint name="pick_box_joint"/>
      <geom name="pick_box_geom" type="box" size="0.010 0.010 0.010"
            density="60" material="pick_box"
            friction="2.5 0.5 0.05" solref="0.008 1" solimp="0.98 0.99 0.001"
            condim="6" contype="3" conaffinity="3"/>
    </body>

    <camera name="topdown" pos="0.18 0 1.05"
            xyaxes="0 1 0 -1 0 0" fovy="50"/>
    <camera name="overview" pos="0.85 -0.65 0.55"
            xyaxes="0.8 0.6 0 -0.25 0.35 0.90" fovy="45"/>
    <camera name="follow" pos="0.55 0.40 0.35"
            xyaxes="-0.7 0.7 0 -0.3 -0.3 0.9" fovy="50"/>
  </worldbody>
</mujoco>
