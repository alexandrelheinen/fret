<?xml version="1.0"?>
<!--
  FRET wrapper for Universal Robots description.

  Extends ur_description/urdf/ur_macro.xacro with a Gazebo
  JointStatePublisher plugin required for Gazebo Harmonic / ros_gz_bridge.

  The gz-sim-joint-state-publisher-system plugin makes Gazebo publish
  /model/<name>/joint_state (gz.msgs.Model), which ros_gz_bridge converts to
  sensor_msgs/JointState on /joint_states.  robot_state_publisher then
  consumes /joint_states to publish the full TF tree.

  Arguments mirror ur_description/urdf/ur.urdf.xacro.
  Pass ur_type:=<model> (e.g. ur3, ur5e) at launch time.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">

  <!-- ── Arguments ─────────────────────────────────────────────────── -->
  <xacro:arg name="name"               default="ur"/>
  <xacro:arg name="ur_type"            default="ur3"/>
  <xacro:arg name="tf_prefix"          default=""/>
  <xacro:arg name="joint_limit_params"
      default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params"
      default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params"
      default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params"
      default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="safety_limits"      default="false"/>
  <xacro:arg name="safety_pos_margin"  default="0.15"/>
  <xacro:arg name="safety_k_position"  default="20"/>
  <xacro:arg name="force_abs_paths"    default="false"/>

  <!-- ── UR macro ──────────────────────────────────────────────────── -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <link name="world"/>

  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    force_abs_paths="$(arg force_abs_paths)"
  >
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- ── Gazebo joint-state publisher plugin ──────────────────────── -->
  <!--
    Enables Gazebo Harmonic (gz-sim 8) to publish
      /model/<name>/joint_state  (gz.msgs.Model)
    The ros_gz_bridge consumes this topic and republishes it as
    /joint_states (sensor_msgs/JointState) for robot_state_publisher,
    completing the TF tree from world → base_link → tool0.
  -->
  <gazebo>
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

</robot>
