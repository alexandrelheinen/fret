# Cloudflare R2 credentials for ./scripts/download_showcase.sh
# Copy to .env (gitignored):  cp .env.example .env
#
# Create an R2 API token with Object Read (and Write for CI uploads) scoped to
# your bucket. Same values as GitHub Actions secrets R2_*.

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=fret-renders
