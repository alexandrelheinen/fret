[Unit]
Description=FRET planner (ARCO) on Raspberry Pi 5
After=fret-hardware.service
Requires=fret-hardware.service

[Service]
Type=simple
User=fret
Group=dialout
EnvironmentFile=-/etc/fret/ros.env
Environment=FRET_ROOT=/opt/fret
Nice=10
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash; source /etc/fret/ros.env; source /opt/fret/venv/bin/activate; exec planner_node'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
