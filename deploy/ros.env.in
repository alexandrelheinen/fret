# Sourced by every FRET systemd unit (FR-HW-63).
# Control path runs entirely on the Pi; Wi-Fi loss only cuts PC monitoring.
ROS_DOMAIN_ID=@ROS_DOMAIN_ID@
RMW_IMPLEMENTATION=rmw_zenoh_cpp
ROS_LOG_DIR=/tmp/ros_logs
# PC connects with:
#   ZENOH_CONFIG_OVERRIDE='connect/endpoints=["tcp/@PI_HOSTNAME@:7447"]'
# CycloneDDS fallback: set RMW_IMPLEMENTATION=rmw_cyclonedds_cpp and
#   CYCLONEDDS_URI=file:///etc/fret/cyclonedds.xml
